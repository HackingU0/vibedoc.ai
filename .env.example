# ── LLM (core/agent.py) ───────────────────────────────────────────────────────
LLM_API_KEY=sk-...
LLM_MODEL=deepseek-chat
LLM_ENDPOINT=https://api.deepseek.com

# ── Postgres (core/storage.py) ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/ftcagent

# ── Embeddings — OPTIONAL (core/storage.py) ───────────────────────────────────
# DeepSeek has no embeddings endpoint, so semantic search needs a second
# provider. Leave EMBEDDING_API_KEY unset and everything still works; search()
# just returns nothing. Changing EMBEDDING_DIM after the table exists requires
# dropping and recreating the embedding column.
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Export (exporters/notebook.py) ────────────────────────────────────────────
# The team's own timezone. Timestamps are stored UTC; without this an 8pm
# meeting is filed under the next day.
TEAM_TZ=America/Los_Angeles

# ── Discord (channels/discord_bot.py) ─────────────────────────────────────────
DISCORD_TOKEN=
# Channel ids to listen in, comma separated. Empty = every channel the bot can
# see, which is one LLM call per message.
DISCORD_CHANNELS=
