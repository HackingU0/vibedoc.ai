# ── LLM (core/agent.py) ───────────────────────────────────────────────────────
LLM_API_KEY=sk-...
LLM_MODEL=deepseek-v4-flash
LLM_ENDPOINT=https://api.deepseek.com

# ── Postgres (core/storage.py) ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/ftcagent

# ── Embeddings — OPTIONAL (core/storage.py) ───────────────────────────────────
# DeepSeek has no embeddings endpoint, so semantic search needs a second
# provider. Leave EMBEDDING_API_KEY unset and everything still works; search()
# just returns nothing. Changing EMBEDDING_DIM after the table exists requires
# dropping and recreating the embedding column.
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Digest (core/digest.py) ───────────────────────────────────────────────────
# Days a thread with holes may go untouched before /digest calls it stale.
# UNMEASURED, like TASK_IDLE_MINUTES — a season has quiet weeks.
DIGEST_STALE_DAYS=10

# ── Export (exporters/) ───────────────────────────────────────────────────────
# How far back the board looks. A board is "what is on the go"; a season of
# closed spans is a notebook, not a board.
BOARD_DAYS=14
# The team's own timezone. Timestamps are stored UTC; without this an 8pm
# meeting is filed under the next day.
TEAM_TZ=America/Los_Angeles

# ── Discord (channels/discord_bot.py) ─────────────────────────────────────────
DISCORD_TOKEN=
# Channel ids to listen in, comma separated. Empty = every channel the bot can
# see, which is one LLM call per message.
DISCORD_CHANNELS=
# Dev only: sync slash commands to this one guild (instant) instead of globally
# (up to an hour to appear). Leave unset in production.
DISCORD_GUILD_ID=

# Post a short recap when the channel goes quiet for SESSION_IDLE_MINUTES.
# OFF by default; switch it on only once the capture path is trusted.
SESSION_RECAP=off
SESSION_IDLE_MINUTES=90

# How long one person must stay quiet before their burst is parsed as one unit.
BURST_QUIET_SECONDS=45
# Flush a monologue without waiting once it reaches this many messages.
BURST_MAX_ITEMS=10

# Hard ceiling on follow-up rounds per record.
FOLLOWUP_MAX_ROUNDS=3
# Unanswered questions allowed outstanding in one channel at once.
MAX_OPEN_QUESTIONS=2

# ── Work spans (core/progress.py) ─────────────────────────────────────────────
# How long one person must go quiet on one component before that stretch of
# work counts as finished. Feeds the notebook's session timeline and the "one
# question per task" follow-up gate. UNMEASURED — read
# docs/design/progress-tracker.md §10 before changing it.
TASK_IDLE_MINUTES=60
